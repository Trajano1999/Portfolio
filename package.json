{
    "name": "portfolio",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun vite .",
        "format": "bun prettier . --write --log-level warn",
        "format-check": "bun prettier . --check --log-level warn",
        "lint": "bun eslint . --fix",
        "lint-check": "bun eslint .",
        "fix": "bun run format && bun run lint",
        "fix-check": "bun run format-check && bun run lint-check",
        "test": "bun vitest .",
        "build": "bun vite build .",
        "preview": "bun run build && bun vite preview .",
        "deps-check": "bunx knip && bun outdated",
        "deps-update": "bunx npm-check-updates -u && bun update --latest && bun install",
        "deps-audit": "bun audit",
        "clean-build": "rm -rf dist",
        "clean-deps": "rm -rf node_modules bun.lock"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "@vercel/analytics": "2.0.1",
        "i18next": "26.3.6",
        "i18next-http-backend": "4.0.1",
        "prettier": "3.9.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-i18next": "17.0.11"
    },
    "devDependencies": {
        "@eslint/compat": "2.1.0",
        "@eslint/eslintrc": "3.3.6",
        "@testing-library/jest-dom": "7.0.0",
        "@testing-library/react": "16.3.2",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.4",
        "@vitest/ui": "4.1.10",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.8.0",
        "jsdom": "30.0.1",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    }
}
